{
    "version": "0.1.50",
    "description": "Cross-platform SSH client with a built-in MCP server — safe SSH access for AI agents.",
    "homepage": "https://termal.in/",
    "license": "Freeware",
    "notes": [
        "Termalin keeps saved hosts, keys and snippets encrypted at rest under %LOCALAPPDATA%\\Termalin; that data persists across upgrades/uninstall.",
        "The app has a built-in auto-updater. When installed via Scoop, prefer 'scoop update termalin' so Scoop stays the source of truth."
    ],
    "architecture": {
        "64bit": {
            "url": "https://termal.in/download/Termalin-Setup-0.1.50.exe",
            "hash": "40d004535cb8341166fd7be6978f8094a271752cd0b3db564896d0f9baaaa1f2"
        }
    },
    "innosetup": true,
    "bin": "termalin.exe",
    "shortcuts": [
        [
            "termalin.exe",
            "Termalin"
        ]
    ],
    "post_install": [
        "# Scoop's unpacker saves the installer's two copies of the core library as",
        "# termalin_core,1.dll and termalin_core,2.dll; the app loads termalin_core.dll.",
        "$copies = @(Get-ChildItem \"$dir\" -Filter 'termalin_core,*.dll' | Sort-Object Name)",
        "if (!(Test-Path \"$dir\\termalin_core.dll\") -and $copies.Count) { Copy-Item $copies[0].FullName \"$dir\\termalin_core.dll\" }",
        "$copies | Remove-Item -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://termal.in/api/v1/updates/latest?platform=windows",
        "jsonpath": "$.data.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://termal.in/download/Termalin-Setup-$version.exe"
            }
        },
        "hash": {
            "url": "https://termal.in/api/v1/updates/latest?platform=windows",
            "jsonpath": "$.data.sha256"
        }
    }
}
